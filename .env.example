APP_ENV=dev
LOG_LEVEL=INFO

# --- Base de datos ---
# SQLite (dev rapido, sin Docker):
DATABASE_URL=sqlite:///./marketing.db
# PostgreSQL (paso 2 en adelante):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/marketing_mvp

# --- Cola de tareas ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Origenes permitidos para el navegador. Separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# =============================================================================
# PASO 3A — LLMs
# Provider: anthropic | openai  (si ambas claves estan vacias usa stubs mockeados)
# =============================================================================
LLM_PROVIDER=anthropic
# Modelos disponibles: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Solo necesario si LLM_PROVIDER=openai
OPENAI_API_KEY=

# =============================================================================
# PASO 3B — Generacion de imagenes
# Provider: fal | venice | stable_diffusion | openai | canva | mock
# =============================================================================
IMAGE_PROVIDER=fal

# --- fal.ai (proveedor principal — Flux Pro vía API, sin GPU local) ---
# Obtén tu key en fal.ai → Dashboard → API Keys
FAL_API_KEY=
# Modelos disponibles: fal-ai/flux-pro/v1.1 | fal-ai/flux/schnell | fal-ai/recraft-v3
FAL_MODEL=fal-ai/flux-pro/v1.1
# Img2Img cuando el usuario sube foto y activa "Alterar imagen con IA"
FAL_IMG2IMG_MODEL=fal-ai/flux/dev/image-to-image
FAL_IMG2IMG_STRENGTH=0.72

# --- Venice.ai (imagen síncrona + animación de escenas de Reel) ---
# Key: https://venice.ai/token — docs: https://docs.venice.ai
# Base REAL (no /v1 suelto): https://api.venice.ai/api/v1
VENICE_API_KEY=
VENICE_API_BASE=https://api.venice.ai/api/v1
# Imagen:
#   venice-sd35          → width/height (máx 1280; prompt ≤1500)
#   nano-banana-pro      → Google Nano Banana (aspect_ratio + resolution 1K|2K|4K)
#   nano-banana-2        → variante Nano Banana
#   qwen-image-2         → solo aspect_ratio
VENICE_IMAGE_MODEL=venice-sd35
VENICE_IMAGE_STYLE_PRESET=
# Solo para nano-banana* / gpt-image-2
VENICE_IMAGE_RESOLUTION=2K
# Escenas de Reel: still (Ken Burns en Shotstack) | venice (image-to-video por escena)
VIDEO_GEN_MODE=scenes
# full = un clip Venice AI | scenes = unir tomas AI | still = stills+Ken Burns
VIDEO_SCENE_PROVIDER=venice
# Alias: seedance-2.5 | seedance-2.0 | kling-o3 | kling-o3-pro | minimax-h3
# (Seedance 2.5 se mapea a Seedance 2.0 si Venice aún no publica 2.5)
VENICE_VIDEO_MODEL=seedance-2.0
VENICE_VIDEO_DURATION=5s
VENICE_VIDEO_RESOLUTION=720p

# --- OCR + escaneo visual (manual de marca PDF) ---
# Flujo: pypdf → si texto corto y OCR_PROVIDER=paddle → PaddleOCR
# Luego brand_scan: paleta dominante + logos embebidos/cabecera → active.json
# Instalar: pip install pypdf pymupdf paddlepaddle paddleocr
OCR_PROVIDER=paddle
OCR_LANG=es
OCR_USE_GPU=true
OCR_MIN_TEXT_CHARS=40
OCR_MAX_PAGES=40
OCR_DPI=200

# --- Stable Diffusion (Automatic1111 / Forge) ---
# Arrancar WebUI con --api en el puerto 7860
STABLE_DIFFUSION_URL=http://127.0.0.1:7860/sdapi/v1/txt2img
# Nombre EXACTO del checkpoint en el desplegable del WebUI (archivo en models/Stable-diffusion/)
# Ej. Realistic Vision V5.1 fp16 no-ema suele verse como:
# STABLE_DIFFUSION_CHECKPOINT=Realistic_Vision_V5.1_fp16-no-ema.safetensors
STABLE_DIFFUSION_CHECKPOINT=

# --- OpenAI DALL-E 3 (requiere OPENAI_API_KEY arriba) ---
# IMAGE_PROVIDER=openai

# --- Canva (requiere OAuth — ver image_providers.py) ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_TEMPLATE_ID=

# =============================================================================
# PASO 3C — Publicacion en redes sociales
# Provider: mock | linkedin | meta
# OAuth Meta/LinkedIn en dashboard (Integraciones) + sidecar Go :8088
# =============================================================================
SOCIAL_PROVIDER=mock

# --- LinkedIn nativo (OAuth + imagen vía publisher Python / Go) ---
# 1) App en https://www.linkedin.com/developers/
# 2) Productos: Community Management API + Sign In with LinkedIn (OpenID Connect)
# 3) Auth → Redirect URLs: debe coincidir EXACTO con LINKEDIN_REDIRECT_URI (path completo)
# 4) Scopes en login: openid profile w_member_social
# 5) Dashboard → Integraciones → Conectar LinkedIn (multi-cuenta: "Conectar otra" agrega filas)
# Tras migración Alembic 0007, reconectar para poblar account_name / profile_picture_url.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/callback/linkedin
# Con ngrok: https://TU-DOMINIO.ngrok-free.dev/api/auth/callback/linkedin
# Legacy estático (solo dev sin OAuth):
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Meta / Instagram Business (SOCIAL_PROVIDER=meta)
# Cuenta IG profesional vinculada a una Pagina de Facebook en Meta Business Suite.
# Multi-cuenta: OAuth en Integraciones crea una fila por Fan Page con IG (migración 0007).
# Guia: https://developers.facebook.com/docs/instagram-api/getting-started
# Permisos tipicos del token: instagram_basic, instagram_content_publish, pages_show_list
META_APP_ID=
META_APP_SECRET=
# Token de Pagina (long-lived) con acceso a la cuenta de Instagram conectada
META_PAGE_ACCESS_TOKEN=
# ID numerico de la cuenta de Instagram (IG User ID en Graph API Explorer / Business Suite)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Opcional; version de Graph API (por defecto el codigo usa v21.0 si vacio)
GRAPH_API_VERSION=v21.0

# =============================================================================
# PASO 3D — Video y voz (Reels — Video-as-Code)
# Reel es async-only: se dispara con POST /api/runs/async y content_format=reel
# (rechazado con 422 en /api/runs/sync). Corre un segundo worker Celery en la
# cola dedicada: `celery -A workers.celery_app worker -Q video_render`
# =============================================================================

# --- Render de video --- Provider: shotstack | json2video | mock
VIDEO_PROVIDER=shotstack
# Cuenta gratuita en https://shotstack.io (sandbox/stage antes de produccion)
# Key sandbox → SHOTSTACK_ENV=stage (watermark). Key produccion → SHOTSTACK_ENV=v1
SHOTSTACK_API_KEY=
# stage (sandbox, gratis) | v1 (produccion, de pago)
SHOTSTACK_ENV=stage
# Alternativa documentada, no implementada en v1
JSON2VIDEO_API_KEY=
# Segundos maximos de espera del poll block-and-poll antes de fallar (video_render_timeout)
VIDEO_MAX_WAIT_SECONDS=600
VIDEO_FPS=30
# Overlays: to_shotstack_edit() usa clips TitleAsset (pista superior), no title_asset.
# Antes del submit, video_providers reescribe localhost → PUBLIC_IMAGE_BASE_URL (ngrok).
# Con VOICE_PROVIDER=fal + fondos fal.ai, Shotstack descarga de fal.media (sin ngrok en el render).

# --- Voz en off (voiceover) --- Provider: fal | elevenlabs | openai | mock
# En dev se recomienda fal (reusa FAL_API_KEY; Kokoro Spanish nativo).
VOICE_PROVIDER=fal
# Idioma por defecto de la narracion (español)
VOICE_LANGUAGE=es
FAL_TTS_MODEL=fal-ai/kokoro/spanish
# Voces: ef_dora | em_alex | em_santa
FAL_TTS_VOICE=ef_dora
# Alternativa ElevenLabs (https://elevenlabs.io) si VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Voz multilingue por defecto (funciona en español con eleven_multilingual_v2)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# OPENAI_API_KEY (seccion 3A arriba) se reutiliza si VOICE_PROVIDER=openai

# =============================================================================
# PASO 4 — Seguridad y Human-in-the-loop
# =============================================================================

# API Key para autenticación Bearer. Vacío = auth desactivada (dev local).
# En producción: genera con `python -c "import secrets; print(secrets.token_urlsafe(32))"`
API_KEY=

# Slack Incoming Webhook para notificaciones human-in-the-loop.
# Cuando un run entra en pending_approval, se envía un mensaje a este webhook.
# Crea el webhook en: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# =============================================================================
# Microservicio Go (publicador sidecar)
# =============================================================================
GO_PUBLISHER_URL=http://localhost:8088

# URL pública HTTPS (ngrok en dev). Obligatoria para Meta (publicar) y assets locales
# (user_clip_reel, overlays Pillow, wan-effects). En Reels fal-only el render usa fal.media.
# Preferir dominio fijo: ngrok http --url=TU-DOMINIO.ngrok-free.dev 8000
PUBLIC_IMAGE_BASE_URL=


# =============================================================================
# OAuth 2.0 (Meta / LinkedIn / Google Drive)
# =============================================================================

# --- Meta (Facebook/Instagram Graph API) ---
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/auth/callback/meta
# Con ngrok: https://TU-DOMINIO.ngrok-free.dev/api/auth/callback/meta
# (URI completa en Meta Developers → Valid OAuth Redirect URIs; scopes IG al autorizar)
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/

# --- Google Drive (fuente de clips de video del usuario, PASO 5) ---
# App en https://console.cloud.google.com/ -> APIs y servicios -> Credenciales
# Scope: drive.readonly. Para usuarios fuera de tu organizacion, Google exige
# verificacion manual de la app (proceso de dias/semanas) antes de aprobar el
# scope en produccion; en dev, agrega los emails de prueba en la pantalla de
# consentimiento OAuth (modo "Testing") para evitar la verificacion.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google

# =============================================================================
# PASO 5 - Video con clips del usuario (Drive -> transcripcion -> Reel)
# content_format=user_clip_reel es async-only (igual que reel): POST /api/runs/async
# con drive_folder_id obligatorio (422 si falta o si se usa /runs/sync).
# Requiere ffmpeg instalado en el host (ver README) para extraer audio de los clips.
# =============================================================================

# --- Transcripcion (Whisper) --- Provider: whisper | mock
STT_PROVIDER=whisper

# --- Efecto visual generativo opcional (fal.ai wan-effects) sobre el segmento hook ---
EFFECTS_ENABLED=false
FAL_EFFECTS_MODEL=fal-ai/wan-effects
