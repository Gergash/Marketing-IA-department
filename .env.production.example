# Producción en VPS Hostinger KVM 4 (coexistencia con InsightFlow)
# Guía: infra/deploy/vps-hostinger.md
# Caddy del HOST gestiona TLS — este compose NO abre 80/443.
#
# Copia a `.env.production` en la raíz del repo (NUNCA commits).
# docker compose -f infra/docker-compose.prod.yml --env-file .env.production up -d --build

DOMAIN=marketing.powerupsecosistem.online

POSTGRES_USER=marketing
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE
POSTGRES_DB=marketing_mvp

# Auth del dashboard (obligatorio en prod)
API_KEY=

APP_ENV=production
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=demo-tenant
CORS_ORIGINS=https://marketing.powerupsecosistem.online

# LLM — OpenRouter vía interfaz OpenAI-compatible (no Ollama en VPS compartida).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.0-flash-001
OPENROUTER_HTTP_REFERER=https://marketing.powerupsecosistem.online
OPENROUTER_APP_TITLE=Marketing DEPA IA
# Alternativa Anthropic directa:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=

IMAGE_PROVIDER=fal
FAL_API_KEY=
# VENICE_API_KEY=

VOICE_PROVIDER=fal
VIDEO_PROVIDER=shotstack
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

SOCIAL_PROVIDER=meta

# Meta / Instagram / Facebook — producción (debe coincidir EXACTO con Meta Developers)
META_CLIENT_ID=
META_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_FACEBOOK_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
OAUTH_SUCCESS_REDIRECT_URL=https://marketing.powerupsecosistem.online/
PUBLIC_IMAGE_BASE_URL=https://marketing.powerupsecosistem.online
META_REDIRECT_URI=https://marketing.powerupsecosistem.online/api/auth/callback/meta
# Guía portal Meta: infra/deploy/meta-oauth-production.md

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://marketing.powerupsecosistem.online/api/auth/callback/linkedin

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
# Opcional: Access Token + Secret de la app (OAuth 1.0a user context)
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok domain verify (archivo .txt en la raíz HTTPS)
TIKTOK_VERIFY_FILENAME=
TIKTOK_VERIFY_CONTENT=

THOUGHTS_ENABLED=true
PROMETHEUS_ENABLED=false
