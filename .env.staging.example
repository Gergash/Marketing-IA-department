# Staging local — landing + login + Bold + créditos
# Copia a .env y activa STAGING_SAAS_ENABLED=true

STAGING_SAAS_ENABLED=true
JWT_SECRET=cambia-esto-por-un-secreto-largo-en-local
JWT_TTL_MINUTES=10080

# Bold (Integraciones → Botón de pagos en panel Bold)
# BOLD_WEBHOOK_SECRET = misma llave secreta que BOLD_INTEGRITY_SECRET
BOLD_API_KEY=
BOLD_INTEGRITY_SECRET=
BOLD_WEBHOOK_SECRET=
PACK_AMOUNT_COP=99000
CREDITS_PER_PACK=100
STAGING_SUCCESS_REDIRECT_URL=http://localhost:5173/app?paid=1

# Frontend (frontend/.env.local)
# VITE_STAGING_SAAS=true

# Agente de DMs en local (docs/staging-e2e.md → "Agente de DMs en staging local")
# Pasar con: uvicorn ... --env-file .env.staging.local  ·  worker: set -a && source .env.staging.local && set +a
LLM_PROVIDER=openai
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENAI_MODEL_FALLBACKS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free
LLM_MAX_RETRIES=3
OPENROUTER_DISABLE_REASONING=true
META_WEBHOOK_VERIFY_TOKEN=
DM_DEBOUNCE_SECONDS=4
# true = respuesta guardada en la Bandeja sin enviarse a Meta (scripts/simulate_dm.py)
DM_AGENT_DRY_RUN=true
